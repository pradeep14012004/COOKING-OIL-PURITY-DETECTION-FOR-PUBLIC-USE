#include <WiFiS3.h>
#include <ThingSpeak.h>
#include <Adafruit_TCS34725.h>
#include <LiquidCrystal_I2C.h>

// WiFi credentials
char ssid[] = "";
char pass[] = "";

// ThingSpeak settings
WiFiClient client;
unsigned long myChannelNumber = 2995047;
const char *myWriteAPIKey = "TOJFB42QIVU3SMMQ";

// Sensor Pins
const int pHpin = A0;
const int turbidityPin = A1;

// LED Pins
const int greenLED = 3;
const int yellowLED = 4;
const int redLED = 5;

// Calibrated slope and intercept for pH (from your doc)
float pHSlope = -7.07;
float pHIntercept = 37.19;

// Turbidity polynomial coefficients (example, update with your calibration)
// turbidity = a*V^2 + b*V + c
float turbidityA = 0.0;  // example: 0.0 if linear approx
float turbidityB = -648.88;  // keep your original slope here for linear approx
float turbidityC = 2961.47;  // intercept

// Color sensor setup
Adafruit_TCS34725 tcs = Adafruit_TCS34725(
  TCS34725_INTEGRATIONTIME_50MS,
  TCS34725_GAIN_4X
);

// LCD setup
LiquidCrystal_I2C lcd(0x27, 16, 2);

void setup() {
  Serial.begin(9600);

  pinMode(greenLED, OUTPUT);
  pinMode(yellowLED, OUTPUT);
  pinMode(redLED, OUTPUT);

  // Connect to WiFi
  while (WiFi.begin(ssid, pass) != WL_CONNECTED) {
    Serial.print(".");
    delay(1000);
  }
  Serial.println("\nWiFi connected!");
  ThingSpeak.begin(client);

  // Color sensor init
  if (tcs.begin()) {
    Serial.println("TCS34725 sensor found.");
  } else {
    Serial.println("No TCS34725 sensor found. Check wiring!");
    while (1);
  }

  // LCD init
  lcd.init();
  lcd.backlight();
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Oil Monitor Ready");
  delay(2000);
}

float readPH() {
  int pHraw = analogRead(pHpin);
  float voltagePH = pHraw * (5.0 / 1023.0);
  float pHValue = pHSlope * voltagePH + pHIntercept;

  // Fail-safe
  if (pHraw < 10) pHValue = 0;

  return pHValue;
}

float readTurbidity() {
  int turbRaw = analogRead(turbidityPin);
  float voltageTurb = turbRaw * (5.0 / 1023.0);

  // Second order polynomial turbidity calculation
  float turbidityValue = turbidityA * voltageTurb * voltageTurb + turbidityB * voltageTurb + turbidityC;

  // Fail-safe
  if (turbRaw < 10) turbidityValue = 0;

  return turbidityValue;
}

float readColor(float &Rnorm, float &Gnorm, float &Bnorm) {
  uint16_t r, g, b, c;
  tcs.getRawData(&r, &g, &b, &c);

  // Fail-safe
  if (c < 10) {
    Rnorm = 0;
    Gnorm = 0;
    Bnorm = 0;
    return 0;
  }

  Rnorm = (float)r / c;
  Gnorm = (float)g / c;
  Bnorm = (float)b / c;

  float avgColor = (Rnorm + Gnorm + Bnorm) / 3.0;
  return avgColor;
}

void updateLEDs(String status) {
  if (status == "Good Oil") {
    digitalWrite(greenLED, HIGH);
    digitalWrite(yellowLED, LOW);
    digitalWrite(redLED, LOW);
  } else if (status == "Used Oil") {
    digitalWrite(greenLED, LOW);
    digitalWrite(yellowLED, HIGH);
    digitalWrite(redLED, LOW);
  } else {  // Bad Oil
    digitalWrite(greenLED, LOW);
    digitalWrite(yellowLED, LOW);
    digitalWrite(redLED, HIGH);
  }
}

void loop() {
  float pHValue = readPH();
  float turbidityValue = readTurbidity();

  float Rnorm, Gnorm, Bnorm;
  float colorValue = readColor(Rnorm, Gnorm, Bnorm);

  int oilstatus_no;
  String oilStatus;

  // Classification thresholds (adjust as needed)
  if (pHValue > 6.5 && turbidityValue < 200 && colorValue > 0.6) {
    oilStatus = "Good Oil";
    oilstatus_no = 1;
  } else if (pHValue > 5.5 && turbidityValue < 500 && colorValue > 0.4) {
    oilStatus = "Used Oil";
    oilstatus_no = 2;
  } else {
    oilStatus = "Bad Oil";
    oilstatus_no = 3;
  }

  updateLEDs(oilStatus);

  // Serial monitor output
  Serial.println("=== Sensor Readings ===");
  Serial.print("pH: "); Serial.println(pHValue, 2);
  Serial.print("Turbidity: "); Serial.println(turbidityValue, 2);
  Serial.print("Normalized Color R: "); Serial.print(Rnorm, 3);
  Serial.print(" G: "); Serial.print(Gnorm, 3);
  Serial.print(" B: "); Serial.print(Bnorm, 3);
  Serial.print(" | Avg Norm Color: "); Serial.println(colorValue, 3);
  Serial.println("Oil Status: " + oilStatus);
  Serial.println("=======================\n");

  // LCD output
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("pH:"); lcd.print(pHValue, 1);
  lcd.print(" T:"); lcd.print(turbidityValue, 0);
  lcd.setCursor(0, 1);
  lcd.print("Status: "); lcd.print(oilStatus);

  // Upload to ThingSpeak
  ThingSpeak.setField(1, pHValue);
  ThingSpeak.setField(2, turbidityValue);
  ThingSpeak.setField(3, colorValue);
  ThingSpeak.setField(4, oilstatus_no);

  int status = ThingSpeak.writeFields(myChannelNumber, myWriteAPIKey);
  if (status == 200) {
    Serial.println("Data sent to ThingSpeak successfully!\n");
  } else {
    Serial.print("ThingSpeak Error: ");
    Serial.println(status);
  }

  delay(10000);  // Wait 10 seconds before next reading
}
